# Copy this file to .env to use it: `npm run dev` reads it, and Docker Compose
# substitutes it into compose.yml.

# --- Docker Compose ---------------------------------------------------------
#
# The stack's credentials are made-up local-only values in the shared compose file
# (shared-compose/compose.yml in digital-waste-tracking-uat), so none are needed here.

# Use a local checkout of the shared compose file, to try changes to it
# SHARED_COMPOSE=../digital-waste-tracking-uat/shared-compose/compose.yml

# Image versions for the services this repo doesn't build (default: latest)
# WASTE_TRACKING_EXTERNAL_API_VERSION=latest
# WASTE_MOVEMENT_BACKEND_VERSION=latest
# WASTE_TRACKING_ID_BACKEND_VERSION=latest
# WASTE_ORGANISATION_BACKEND_VERSION=latest
# DWT_CLIENT_SYNC_VERSION=latest

# --- npm run dev ------------------------------------------------------------

# Callers' Basic auth credentials. Every ACCESS_CRED_* variable is one caller,
# its value the base64 of <username>=<password>, e.g.
#   echo -n "waste-movement-external-api=your-secret" | base64
# ACCESS_CRED_WASTE_MOVEMENT_EXTERNAL_API=your-base64-encoded-credentials-here

# waste-tracking-id-backend, which mints movement and delivery IDs. Defaults to
# the one in the same CDP environment (ENVIRONMENT, default local). The Compose
# stack publishes it on port 3003.
# WASTE_TRACKING_URL=http://localhost:3003

# The password this service sends to waste-tracking-id-backend as user
# waste-movement-api. It must match that service's ACCESS_CRED_WASTE_MOVEMENT_API
# (base64 of waste-movement-api=<password>); the Compose stack's is
# local-movement-api.
# SERVICE_AUTH_PASSWORD_WASTE_MOVEMENT_API=your-password-here

# Base URI of the RFC 9457 problem types in error responses
# PROBLEM_DETAILS_TYPE_BASE=https://defra.github.io/digital-waste-tracking-api-site/preview/problems/
