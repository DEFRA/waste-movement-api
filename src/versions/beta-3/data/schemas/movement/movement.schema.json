{
  "title": "Movement",
  "description": "A Movement, as stored in `beta-3-g<N>-movements` for `POST /movements`.",
  "bsonType": "object",
  "additionalProperties": false,
  "required": [
    "_id",
    "orgId",
    "revision",
    "createdAt",
    "updatedAt",
    "traceId",
    "payload",
    "isHazardous"
  ],
  "properties": {
    "_id": {
      "bsonType": "string",
      "description": "The Movement ID."
    },
    "orgId": { "$ref": "../common/envelope.schema.json#/properties/orgId" },
    "revision": {
      "$ref": "../common/envelope.schema.json#/properties/revision"
    },
    "createdAt": {
      "$ref": "../common/envelope.schema.json#/properties/createdAt"
    },
    "updatedAt": {
      "$ref": "../common/envelope.schema.json#/properties/updatedAt"
    },
    "traceId": {
      "$ref": "../common/envelope.schema.json#/properties/traceId"
    },
    "payload": {
      "$ref": "../common/envelope.schema.json#/properties/payload",
      "description": "The `POST /movements` request body, as sent."
    },
    "isHazardous": {
      "bsonType": "bool",
      "description": "Whether any of its waste items declares hazardous properties, which decides how `POST /deliveries` groups it."
    }
  }
}
