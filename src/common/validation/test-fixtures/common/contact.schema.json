{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Either an email address, or an object with a phone number",
  "oneOf": [
    {
      "description": "An email address",
      "type": "string",
      "format": "email"
    },
    {
      "description": "A phone number",
      "type": "object",
      "additionalProperties": false,
      "required": ["phoneNumber"],
      "properties": {
        "phoneNumber": { "description": "A phone number", "type": "string" }
      }
    }
  ]
}
