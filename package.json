{
  "name": "waste-movement-api",
  "version": "0.0.0",
  "description": "waste-movement-api",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development npm run server:watch",
    "dev:debug": "NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "node --watch --inspect-brk=0.0.0.0 --env-file-if-exists=.env ./src",
    "server:watch": "node --watch --inspect=0.0.0.0 --env-file-if-exists=.env ./src",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module",
    "start": "NODE_ENV=production node . --env-file-if-exists=.env",
    "test": "TZ=UTC vitest run --coverage",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.js",
    "test:watch": "TZ=UTC vitest"
  },
  "imports": {
    "#/*": "./src/*",
    "#test/*": "./test/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1161.0",
    "@defra/hapi-secure-context": "0.4.2",
    "@defra/hapi-tracing": "1.30.2",
    "@defra/waste-movement-utils": "1.21.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.13",
    "@hapi/wreck": "18.1.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "exponential-backoff": "3.1.3",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "mongodb": "7.8.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "mongodb-memory-server": "10.4.2",
    "neostandard": "0.14.1",
    "prettier": "3.9.10",
    "vitest": "5.1.0",
    "vitest-mongodb": "1.0.3"
  }
}
